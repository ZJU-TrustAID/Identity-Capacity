{
  "base_config": "base.jsonc",

  "run_name": "dwt-dct-clean-pilot",
  "method_name": "dwt_dct",
  "payload_length": 64,
  "output_dir": "${paths.outputs_root}/${run_name}",

  "dataset": {
    "name": "COCO",
    "modality": "image",
    "root": "${paths.datasets.coco_val2017}",
    "split": "val2017",
    "subset_count": 10,
    "subset_seed": 1453,
    "manifest_path": "${paths.manifests_root}/coco-dwt-dct-pilot.jsonl"
  },

  "method_params": {
    "method": "dwtDct",
    "scales": [0, 36, 36],
    "block": 4
  },

  "notes": {
    "method_source": "third_party/invisible-watermark",
    "preprocessing": "worker resizes DWT-DCT inputs to 256x256 before embed/decode"
  }
}
