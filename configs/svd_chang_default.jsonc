{
  "base_config": "base.jsonc",

  "run_name": "svd-chang-clean-pilot",
  "method_name": "svd_chang",
  "payload_length": 64,
  "output_dir": "${paths.outputs_root}/${run_name}",

  "dataset": {
    "name": "COCO",
    "modality": "image",
    "root": "${paths.datasets.coco_val2017}",
    "split": "val2017",
    "subset_count": 10,
    "subset_seed": 1453,
    "manifest_path": "${paths.manifests_root}/coco-svd-chang-pilot.jsonl"
  },

  "method_params": {
    "method": "svd_chang",
    "payload_length": 64,
    "image_size": 256,
    "num_blocks_per_side": 32,
    "seed": 100,
    "t": 0.01
  },

  "notes": {
    "method_source": "Chang, Tsai, and Lin 2005 formula reimplementation",
    "preprocessing": "worker converts images to grayscale and resizes them to 256x256 before embed/decode",
    "payload_length": "configurable; one payload bit is embedded per selected image block"
  }
}
