{
  "base_config": "base.jsonc",

  "run_name": "hidden-clean-pilot",
  "method_name": "hidden",
  "payload_length": 30,
  "output_dir": "${paths.outputs_root}/${run_name}",

  "dataset": {
    "name": "COCO",
    "modality": "image",
    "root": "${paths.datasets.coco_val2017}",
    "split": "val2017",
    "subset_count": 10,
    "subset_seed": 1453,
    "manifest_path": "${paths.manifests_root}/coco-hidden-pilot.jsonl"
  },

  "method_params": {
    "device": "cpu"
  }
}
