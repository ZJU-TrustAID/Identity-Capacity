{
  "base_config": "base.jsonc",

  "run_name": "audioseal-clean-pilot",
  "method_name": "audioseal",
  "payload_length": 16,
  "output_dir": "${paths.outputs_root}/${run_name}",

  "dataset": {
    "name": "VCTK",
    "modality": "audio",
    "root": "${paths.datasets.vctk}",
    "split": "train",
    "subset_count": 10,
    "subset_seed": 1453,
    "manifest_path": "${paths.manifests_root}/vctk-audioseal-pilot.jsonl"
  },

  "method_params": {
    "device": "cpu",
    "sample_rate": 16000,
    "alpha": 1.0,
    "message_threshold": 0.5,
    "detection_threshold": 0.5,
    "batch_truncate_seconds": 3.0
  }
}
